---
interface Props {
  conditions: Array<{
    key: string;
    label: string;
    summary: string;
    detail: string;
  }>;
}

const { conditions } = Astro.props;
---

<div class="interactive-presenter" style="margin: 28px 0; background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px;">
  <div style="margin-bottom: 16px;">
    <span class="badge badge-context" style="margin-bottom: 8px;">INTERACTIVE RELATIONSHIP DIAGRAM</span>
    <h3 style="margin-top: 4px; margin-bottom: 8px;">The Three Conditions of the Arrangement</h3>
    <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 16px;">
      Select a condition to examine the operational arrangement and who was affected. All three conditions remain fully readable below.
    </p>

    <!-- Selection Controls -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      {conditions.map((c, i) => (
        <button 
          type="button" 
          class={`btn presenter-select-btn ${i === 0 ? 'active' : ''}`}
          data-selection={c.key}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Content Blocks (All statically rendered per Spec R2) -->
  <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 16px;">
    {conditions.map((c, i) => (
      <div 
        class={`presenter-target ${i === 0 ? 'selected-highlight' : ''}`}
        data-target-key={c.key}
        style="padding: 16px 20px; border-radius: 4px; background: rgba(14, 17, 23, 0.7); border: 1px solid var(--color-border-subtle); transition: border-color var(--transition-fast), background var(--transition-fast);"
      >
        <div style="font-family: var(--font-title); font-size: 18px; font-weight: 600; color: var(--color-paper); margin-bottom: 6px;">
          {c.label}
        </div>
        <p style="font-size: 17px; margin-bottom: 8px; color: var(--color-paper);">
          {c.summary}
        </p>
        <p style="font-size: 15px; color: var(--color-muted); margin-bottom: 0;">
          <strong>Operational Mechanism:</strong> {c.detail}
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  .presenter-target.selected-highlight {
    border-color: var(--color-accent) !important;
    background: rgba(198, 47, 66, 0.1) !important;
  }
</style>
