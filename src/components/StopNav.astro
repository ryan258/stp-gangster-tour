---
import {stops,stopURL} from '../lib/catalog';
interface Props {index:number;position:'top'|'bottom'}
const {index,position}=Astro.props;
---
<nav class="stop-nav" aria-label={`Reading order (${position})`}>
 <a href={index===0?'/prologue/':stopURL(stops[index-1].id)}>← Previous: {index===0?'Prologue':stops[index-1].title}</a>
 <a href={index===stops.length-1?'/epilogue/':stopURL(stops[index+1].id)}>Next: {index===stops.length-1?'Epilogue':stops[index+1].title} →</a>
</nav>
