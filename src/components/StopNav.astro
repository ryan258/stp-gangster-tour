---
import {stops,stopURL,routeURL} from '../lib/catalog';
import Glyph from './Glyph.astro';

interface Props {index:number;position:'top'|'bottom'}
const {index,position}=Astro.props;
---
<nav class="stop-nav" aria-label={`Reading order (${position})`}>
 <a href={index===0?routeURL('/prologue/'):stopURL(stops[index-1].id)}><Glyph name="previous"/> <span>Previous: {index===0?'Prologue':stops[index-1].title}</span></a>
 <a href={index===stops.length-1?routeURL('/epilogue/'):stopURL(stops[index+1].id)}><span>Next: {index===stops.length-1?'Epilogue':stops[index+1].title}</span> <Glyph name="next"/></a>
</nav>
