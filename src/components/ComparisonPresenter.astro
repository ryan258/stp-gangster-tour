---
interface Props {
  title: string;
  leftKey: string;
  leftLabel: string;
  leftHeading: string;
  leftText: string;
  leftNote?: string;
  rightKey: string;
  rightLabel: string;
  rightHeading: string;
  rightText: string;
  rightNote?: string;
}

const {
  title,
  leftKey,
  leftLabel,
  leftHeading,
  leftText,
  leftNote,
  rightKey,
  rightLabel,
  rightHeading,
  rightText,
  rightNote
} = Astro.props;
---

<div class="interactive-presenter" style="margin: 28px 0; background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px;">
  <div style="margin-bottom: 16px;">
    <span class="badge badge-approx" style="margin-bottom: 8px;">DATED COMPARISON PRESENTATION</span>
    <h3 style="margin-top: 4px; margin-bottom: 8px;">{title}</h3>
    <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 16px;">
      Select an analytical perspective to emphasize its findings. Both sides remain completely present.
    </p>

    <!-- Selection Controls -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <button 
        type="button" 
        class="btn presenter-select-btn active" 
        data-selection={leftKey}
        aria-pressed="true"
      >
        {leftLabel}
      </button>
      <button 
        type="button" 
        class="btn presenter-select-btn" 
        data-selection={rightKey}
        aria-pressed="false"
      >
        {rightLabel}
      </button>
    </div>
  </div>

  <!-- Responsive Comparison Layout (stacked on narrow, 2-col on wider) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
    <!-- Left Column -->
    <div 
      class="presenter-target selected-highlight" 
      data-target-key={leftKey}
      style="padding: 18px; border-radius: 4px; background: rgba(14, 17, 23, 0.7); border: 1px solid var(--color-border-subtle); transition: border-color var(--transition-fast), background var(--transition-fast);"
    >
      <h4 style="font-size: 18px; margin-bottom: 8px; color: var(--color-paper);">{leftHeading}</h4>
      <p style="font-size: 16px; line-height: 1.6; margin-bottom: 12px; color: var(--color-paper);">{leftText}</p>
      {leftNote && (
        <div style="font-size: 14px; color: var(--color-muted); padding-top: 8px; border-top: 1px dashed var(--color-border-subtle);">
          <strong>Record status:</strong> {leftNote}
        </div>
      )}
    </div>

    <!-- Right Column -->
    <div 
      class="presenter-target" 
      data-target-key={rightKey}
      style="padding: 18px; border-radius: 4px; background: rgba(14, 17, 23, 0.7); border: 1px solid var(--color-border-subtle); transition: border-color var(--transition-fast), background var(--transition-fast);"
    >
      <h4 style="font-size: 18px; margin-bottom: 8px; color: var(--color-paper);">{rightHeading}</h4>
      <p style="font-size: 16px; line-height: 1.6; margin-bottom: 12px; color: var(--color-paper);">{rightText}</p>
      {rightNote && (
        <div style="font-size: 14px; color: var(--color-muted); padding-top: 8px; border-top: 1px dashed var(--color-border-subtle);">
          <strong>Record status:</strong> {rightNote}
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .presenter-target.selected-highlight {
    border-color: var(--color-accent) !important;
    background: rgba(198, 47, 66, 0.1) !important;
  }
</style>
