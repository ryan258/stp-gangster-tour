---
import ArtImage from './ArtImage.astro';
interface Props {title:string;eyebrow:string;lede?:string;image:string;folio:string;note?:string;}
const {title,eyebrow,lede,image,folio,note}=Astro.props;
---
<header class="experience-hero">
  <ArtImage class="experience-backdrop" name={image.split('/').pop()!.replace('.webp','')} eager/>
  <div class="container experience-hero-inner">
    <div class="experience-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {lede&&<p class="lede">{lede}</p>}
      <slot/>
      <p class="experience-art-label">Atmospheric artwork · Not an archival image</p>
    </div>
    <div class="experience-marginalia" aria-hidden="true"><span class="experience-folio">{folio}</span>{note&&<p>{note}</p>}<small>Saint Paul After Dark</small></div>
  </div>
</header>
