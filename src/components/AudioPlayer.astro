---
interface Props {
  audioSrc?: string;
  narrationId?: string;
  durationSeconds?: number;
  ambienceSrc?: string;
}
const {
  narrationId,
  durationSeconds,
  audioSrc = narrationId ? `/media/audio/${narrationId}.mp3` : '',
  ambienceSrc = '/media/audio/ambience-city-rain.mp3'
} = Astro.props;
---
<section class="audio-player audio-player-panel card" aria-label="Introduction audio" data-audio-player data-narration-src={audioSrc} data-ambience-src={ambienceSrc} data-duration={durationSeconds}>
 <h2>Listen to the introduction</h2>
 <p class="muted">Synthesized macOS Samantha voice. Listening and pronunciation review pending. The complete transcript is the introduction below.</p>
 <div data-audio-controls hidden>
  <div class="controls">
   <button id="btn-audio-play" type="button">Play narration</button>
   <button id="btn-audio-pause" type="button" hidden>Pause narration</button>
   <button id="btn-audio-restart" type="button" class="btn-secondary">Restart narration</button>
   <button id="btn-mute-all" type="button" class="btn-secondary" aria-pressed="false">Mute all</button>
   <label for="audio-speed-select">Narration speed</label>
   <select id="audio-speed-select"><option value="0.75">0.75×</option><option value="1">1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option></select>
  </div>
  <div class="controls" data-mixer-control>
   <button type="button" class="btn-secondary" data-volume-channel="narrationVolume" data-volume-delta="-0.1">Narration quieter</button><button type="button" class="btn-secondary" data-volume-channel="narrationVolume" data-volume-delta="0.1">Narration louder</button>
   <button type="button" id="btn-toggle-ambience" class="btn-secondary" aria-pressed="false">Toggle ambience</button>
   <button type="button" class="btn-secondary" data-volume-channel="ambienceVolume" data-volume-delta="-0.1">Ambience quieter</button><button type="button" class="btn-secondary" data-volume-channel="ambienceVolume" data-volume-delta="0.1">Ambience louder</button>
  </div>
  <p data-volume-status class="muted" data-mixer-control></p>
  <p data-mixer-notice hidden>Use your device volume for narration. This browser does not support independent audio volume; ambience is disabled.</p>
  <p role="status" data-audio-status>Sound is off. Nothing downloads until you start a channel.</p>
 </div>
 <noscript><p>Audio controls need JavaScript. Read the complete introduction below.</p></noscript>
</section>
<script>
 import {TourAudioController} from '../scripts/audio';
 document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach(root=>new TourAudioController(root).initUI());
</script>
