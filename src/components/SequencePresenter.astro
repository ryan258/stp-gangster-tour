---
interface Props {
  stages: Array<{
    key: string;
    title: string;
    date: string;
    description: string;
  }>;
}

const { stages } = Astro.props;
---

<div class="interactive-presenter" style="margin: 28px 0; background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px;">
  <div style="margin-bottom: 16px;">
    <span class="badge badge-exact" style="margin-bottom: 8px;">DATED SEQUENCE PRESENTATION</span>
    <h3 style="margin-top: 4px; margin-bottom: 8px;">The Three-Stage Breakdown at Lincoln Court</h3>
    <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 16px;">
      Follow the sourced timeline of events from initial tenant suspicion to armed confrontation.
    </p>

    <!-- Selection Controls -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      {stages.map((st, i) => (
        <button 
          type="button" 
          class={`btn presenter-select-btn ${i === 0 ? 'active' : ''}`}
          data-selection={st.key}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {st.title}
        </button>
      ))}
    </div>
  </div>

  <!-- Panels Sequence (All statically present per Spec R2) -->
  <div style="display: flex; flex-direction: column; gap: 14px;">
    {stages.map((st, i) => (
      <div 
        class={`presenter-target ${i === 0 ? 'selected-highlight' : ''}`}
        data-target-key={st.key}
        style="padding: 18px 20px; border-radius: 4px; background: rgba(14, 17, 23, 0.7); border: 1px solid var(--color-border-subtle); transition: border-color var(--transition-fast), background var(--transition-fast);"
      >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
          <h4 style="font-size: 18px; color: var(--color-paper); margin: 0;">{st.title}</h4>
          <span class="badge badge-approx">{st.date}</span>
        </div>
        <p style="font-size: 16px; line-height: 1.6; margin-bottom: 0; color: var(--color-paper);">
          {st.description}
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  .presenter-target.selected-highlight {
    border-color: var(--color-accent) !important;
    background: rgba(198, 47, 66, 0.1) !important;
  }
</style>
