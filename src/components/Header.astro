---
import {edition, routeURL} from '../lib/catalog';
import ArchMark from '../../brand/assets/identity/arch-mark-dark.svg';
import Glyph from './Glyph.astro';
interface Props {currentPath?:string;stopNumber?:number;totalStops?:number}
const {currentPath=routeURL('/'),stopNumber,totalStops=7}=Astro.props;
const navItems = [
  ['/', 'Home'],
  ['/map/', 'Map'],
  ['/casebook/', 'Casebook'],
  ['/sources/', 'Sources'],
  ['/studies/', 'Studies']
];
---
<header class="site-header">
  <div class="header-container">
    <div class="brand-wrapper">
      <a href={routeURL('/')} class="site-brand">
        <ArchMark width={32} height={32} aria-hidden="true" focusable="false" role="presentation"/>
        <span>{edition.title}</span>
      </a>
      {stopNumber && <span class="badge">Stop {stopNumber} of {totalStops}</span>}
    </div>
    <nav class="site-nav" aria-label="Main navigation">
      {navItems.map(([path,label])=>{
        const href=routeURL(path);
        return <a href={href} aria-current={currentPath===href?'page':undefined}>{label}</a>;
      })}
      <button type="button" class="btn-secondary calm-toggle-btn" id="btn-toggle-calm" aria-pressed="false" data-js-control hidden>
        <Glyph name="calm"/> Calm view
      </button>
    </nav>
  </div>
</header>
