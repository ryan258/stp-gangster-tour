---
import {claims,claimURL} from '../lib/catalog';
interface Props {ids:string[];from?:string}
const {ids,from}=Astro.props;
---
<div class="claim-links"><span>Claim basis:</span><ul>{ids.map(id=>{const c=claims.find(item=>item.id===id);return <li><a href={claimURL(id,from)}>{id} — {c?.status}, {c?.evidenceBasis}</a></li>;})}</ul></div>
