---
import Layout from '../layouts/Layout.astro';import ClaimLinks from '../components/ClaimLinks.astro';import {edition,stops,stopURL} from '../lib/catalog';
---
<Layout title="Prologue"><article class="container prose reading-page" data-reading-page="prologue"><section id="opening" data-reading-block><p class="eyebrow">Prologue</p><h1>{edition.prologue.title}</h1>{edition.prologue.paragraphs.map(p=><p>{p}</p>)}<ClaimLinks ids={edition.prologue.premiseClaimIds}/></section><section><h2>Choose your pace</h2><p>The introduction to each stop has optional synthesized narration. Evidence opens in place; the casebook and sources are always available. Sound starts only when you choose it and pauses when you leave the page.</p><p>Reading progress is stored in this browser, with preferences kept separately. No account or score is involved.</p></section><nav class="stop-nav" aria-label="Reading order"><a href="/">← Previous: Home</a><a href={stopURL(stops[0].id)}>Next: {stops[0].title} →</a></nav></article></Layout>
