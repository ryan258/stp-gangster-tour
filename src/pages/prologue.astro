---
import Layout from '../layouts/Layout.astro';
import EditorialChapterHero from '../components/EditorialChapterHero.astro';
import ClaimLinks from '../components/ClaimLinks.astro';
import ArtImage from '../components/ArtImage.astro';
import {edition, stops, stopURL, routeURL} from '../lib/catalog';
import '../styles/editorial-chapters.scss';

const first = stops[0];
---

<Layout title="Prologue" description={edition.prologue.summary}>
  <article class="experience-page bookend-page tour-editorial prologue-page" data-reading-page="prologue">
    <EditorialChapterHero
      title={edition.prologue.title}
      label="Prologue · Saint Paul, beginning in 1900"
      synopsis="Before the hotel suites, the nightclubs, and the ransom notes, there was an arrangement."
      image="hero-skyline"
    >
      <nav class="experience-actions editorial-hero-actions" aria-label="Begin reading">
        <a href="#opening">Open the story <span aria-hidden="true">↓</span></a>
        <a href={stopURL(first.id)}>Go to chapter one <span aria-hidden="true">→</span></a>
      </nav>
    </EditorialChapterHero>

    <div class="container editorial-opening">
      <div class="bookend-prose">
        <section id="opening" data-reading-block class="story-opening">
          <h2>A bargain with a boundary</h2>
          {edition.prologue.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          <details class="story-sources">
            <summary>Sources behind the prologue</summary>
            <ClaimLinks ids={edition.prologue.premiseClaimIds}/>
          </details>
        </section>
      </div>
      <aside class="paper-document prologue-terms" aria-labelledby="terms-heading">
        <p class="paper-kicker">A reading of the record</p>
        <h2 id="terms-heading">The arrangement</h2>
        <ol class="terms-list">
          <li>Identify yourself.</li>
          <li>Pay for protection.</li>
          <li>Keep major crimes outside the city.</li>
        </ol>
        <p>A paraphrase of the arrangement described by the Minnesota Historical Society.</p>
        <a href={routeURL('/sources/#claim-C01')}>Read the claim basis <span aria-hidden="true">↗</span></a>
      </aside>
    </div>

    <div class="container">
      <div class="prologue-guide">
        <section aria-labelledby="pace-heading">
          <h2 id="pace-heading">Choose your pace</h2>
          <p>Read the chapters in order or jump to a place on the map. Each introduction has optional synthesized narration, and evidence opens in place. Calm view reduces decoration and turns ambience off.</p>
          <p>When browser storage is available, your reading position is saved on this device.</p>
        </section>
        <section aria-labelledby="content-heading">
          <h2 id="content-heading">Content note</h2>
          <p>{edition.contentNote}</p>
        </section>
      </div>
      <a class="next-chapter-teaser" href={stopURL(first.id)}>
        <ArtImage name="story-the-arrangement" sizes="(min-width: 1200px) 650px, (min-width: 541px) 54vw, 100vw"/>
        <span>
          <small>Chapter 01 · {first.period}</small>
          <strong>{first.title}</strong>
          <em>{first.chapterNote}</em>
        </span>
        <b aria-hidden="true">→</b>
        <span class="editorial-teaser-art-credit">AI-generated illustration</span>
      </a>
      <nav class="stop-nav" aria-label="Reading order">
        <a href={routeURL('/')}>← Previous: Home</a>
        <a href={stopURL(first.id)}>Next: {first.title} →</a>
      </nav>
    </div>
  </article>
</Layout>
