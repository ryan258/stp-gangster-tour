---
import Layout from '../layouts/Layout.astro';
import {edition,stops,claims,evidence,stopURL,routeURL} from '../lib/catalog';
import ArtImage from '../components/ArtImage.astro';

---
<Layout title="Saint Paul After Dark">
 <div class="experience-page home-experience">
  <!-- 1. Hero Section -->
  <section class="hero-noir">
    <div class="hero-backdrop">
      <ArtImage name="hero-skyline" width={1600} height={900} eager/>
    </div>
    <div class="container">
      <div class="hero-content">
        <span class="hero-eyebrow">1900–1938 · Seven Chapters</span>
        <h1 class="hero-title">
          <span class="title-saint-paul">SAINT PAUL</span>
          <span class="title-after-dark">AFTER DARK</span>
        </h1>
        <p class="hero-tagline">Crime Shaped a City. People Tell Its Story.</p>
        <p class="hero-description">
          Follow the bargain that offered criminals refuge, the people who came for its costs, and the records that complicate the legend.
        </p>
        <div class="hero-actions">
          <a class="btn btn-hero-primary" href={routeURL('/prologue/')}>
            Start the tour <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn-hero-secondary" href={routeURL('/map/')}>
            Explore the seven stops
          </a>
        </div>
        <p><a data-resume hidden href={routeURL('/map/')}>Resume reading</a></p>
      </div>
    </div>
    <div class="hero-script-watermark">
      <span class="script-text">Same city. Different shadows.</span>
      <span class="script-sub">Saint Paul, Minnesota · 1930s inspired artwork</span>
    </div>
  </section>

  <div class="container">
    <nav class="home-entry-strip" aria-label="Explore the experience"><a href="#reading-order"><b>{String(stops.length).padStart(2,'0')}</b><span>Chapters<br/><small>Follow the story</small></span></a><a href={routeURL('/casebook/')}><b>{evidence.length}</b><span>Evidence files<br/><small>Look beneath the legend</small></span></a><a href={routeURL('/sources/')}><b>{claims.length}</b><span>Claim records<br/><small>Trace the source</small></span></a></nav>
    <!-- 2. Read the City Through Its Evidence (Dossier Section) -->
    <section class="evidence-dossier-section">
      <div class="dossier-grid">
        <!-- Left: Vintage Paper Card -->
        <article class="vintage-dossier-card">
          <h2>Read the City Through Its Evidence</h2>
          <p>
            A self-paced reading tour for home use. Each chapter separates historical accounts, records, and interpretation; disputed stories retain their qualifications.
          </p>
          <p class="content-warning">
            {edition.contentNote}
          </p>
          <div class="dossier-icons">
            <div class="icon-col">
              <span class="icon-glyph" aria-hidden="true">01</span>
              <span class="icon-label">Real Records</span>
            </div>
            <div class="icon-col">
              <span class="icon-glyph" aria-hidden="true">02</span>
              <span class="icon-label">Multiple Perspectives</span>
            </div>
            <div class="icon-col">
              <span class="icon-glyph" aria-hidden="true">03</span>
              <span class="icon-label">Places & People</span>
            </div>
          </div>
        </article>

        <!-- Atmospheric illustration in a paper frame -->
        <figure class="vintage-photo-card">
          <div class="photo-tape" aria-hidden="true"></div>
          <div class="photo-inner">
            <ArtImage name="hotel-ryan" alt="Atmospheric illustration of a hotel street corner at night" width={800} height={600} sizes="(min-width: 900px) 320px, 80vw"/>
          </div>
          <figcaption>Atmospheric artwork · not an archival photograph</figcaption>
        </figure>

        <!-- Right: Vintage Book Cover -->
        <div class="vintage-book-card">
          <div class="book-title">
            <span>Seven Chapters</span>
            <span>One City</span>
            <span>Many Perspectives</span>
          </div>
          <div class="book-divider" aria-hidden="true"></div>
          <a href={routeURL('/casebook/')}>Open the casebook <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <!-- 3. The Reading Order Section -->
    <section class="reading-order-section" id="reading-order">
      <div class="section-header-bar">
        <div class="header-left">
          <h2>The Reading Order</h2>
          <div class="header-line" aria-hidden="true"></div>
        </div>
        <div class="header-right">
          <span class="header-sub">Move through time. See how it all connects.</span>
          <a class="reading-map-link" href={routeURL('/map/')}>Open the field map <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <p class="home-art-note">Atmospheric illustrations accompany the chapters; the linked records supply the evidence.</p>
      <ol class="chapter-cards-grid" role="list">
        {stops.map((s, index) => (
          <li class="chapter-card-item">
            <article class="chapter-card">
              <div class="card-backdrop">
                <ArtImage name={`card-${s.id}`} width={600} height={340} sizes="(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw"/>
              </div>
              <div class="card-content">
                <p class="card-period">
                  {index + 1}. {s.period}
                  <span class="visited-badge" data-visited-stop={s.id} data-js-control hidden>Visited</span>
                </p>
                <h3 class="card-title">
                  <a href={stopURL(s.id)}>{s.title}</a>
                </h3>
                <p class="card-synopsis">{s.synopsis}</p>
                <div class="card-action">
                  <span class="circle-arrow" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4. Quote Banner Section -->
    <section class="quote-banner-section">
      <div class="banner-backdrop">
        <ArtImage name="banner-bridge" width={1600} height={900}/>
      </div>
      <div class="banner-content">
        <div class="banner-left">
          <p class="banner-eyebrow">A More Complete Saint Paul</p>
          <p>History isn&rsquo;t just what happened &mdash; it&rsquo;s how we understand it.</p>
        </div>
        <div class="banner-right">
          <p class="tour-reflection">The past is a map.<br/>Look closer at what it leaves out.</p>
          <a href={routeURL('/sources/')}>Explore the sources <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
 </div>
</Layout>
