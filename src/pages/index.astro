---
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
---

<Layout title="Saint Paul After Dark" currentPath="/">
  <div class="landing-hero" style="max-width: 1080px; margin: 0 auto; padding: 20px 0 40px;">
    
    <!-- Hero Image Graphic Noir Skyline -->
    <div class="scene-wrapper" style="margin-bottom: 32px; border: 1px solid var(--color-border); box-shadow: 0 16px 40px rgba(0,0,0,0.6);">
      <img 
        src="/media/scenes/scene-skyline.svg" 
        alt="Saint Paul skyline reflected in the dark Mississippi River with one vivid crimson reflection" 
        width="1200" 
        height="700" 
        loading="eager"
      />
      <div class="scene-caption">
        <span>Saint Paul skyline above the Mississippi River</span>
        <span class="badge badge-context">ILLUSTRATED RECONSTRUCTION</span>
      </div>
    </div>

    <!-- Title & Premise -->
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-size: clamp(38px, 6vw, 68px); letter-spacing: 2px; margin-bottom: 12px;">
        SAINT PAUL AFTER DARK
      </h1>
      <p style="font-family: var(--font-title); font-size: clamp(20px, 3.5vw, 28px); color: var(--color-paper); letter-spacing: 1px; margin: 0 auto 16px; font-weight: 600;">
        {edition.subtitle}
      </p>
      
      <!-- Signature Tagline (Spec R1) -->
      <blockquote style="font-size: clamp(20px, 2.5vw, 24px); color: var(--color-accent); font-style: italic; margin: 24px auto; max-width: 650px;">
        &ldquo;{edition.tagline}&rdquo;
      </blockquote>
    </div>

    <!-- Content Note (Spec R4: non-blocking one-sentence note) -->
    <div style="background: rgba(14, 17, 23, 0.85); border-left: 3px solid var(--color-accent); padding: 14px 20px; border-radius: 4px; margin: 0 auto 36px; max-width: 780px;">
      <p style="font-size: 15px; color: var(--color-muted); margin: 0;">
        <strong style="color: var(--color-paper); text-transform: uppercase;">Historical Content Note:</strong> {edition.contentNote}
      </p>
    </div>

    <!-- Primary Actions (Spec R1: Begin the tour, Explore the map, Resume when available) -->
    <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 48px;">
      <a href="/prologue/" class="btn btn-primary" style="font-size: 20px; padding: 14px 32px;">
        Begin the tour &rarr;
      </a>
      
      <a href="/map/" class="btn btn-secondary" style="font-size: 20px; padding: 14px 28px;">
        Explore the map
      </a>

      <!-- Resume Button (dynamically displayed if valid bookmark exists) -->
      <a 
        href="#" 
        id="btn-resume-tour" 
        class="btn btn-secondary" 
        style="display: none; font-size: 20px; padding: 14px 28px; border-color: #4EBA74; color: #4EBA74;"
      >
        Resume tour
      </a>
    </div>

    <!-- Tour Premise Overview Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 40px; border-top: 1px solid var(--color-border-subtle); padding-top: 40px;">
      <div style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 24px;">
        <h2 style="font-size: 22px; color: var(--color-accent); margin-top: 0; margin-bottom: 8px;">The Arrangement</h2>
        <p style="font-size: 16px; color: var(--color-paper); margin: 0;">
          Beginning in 1900 under Police Chief John O'Connor, Saint Paul offered underworld fugitives sanctuary: register upon arrival, pay tribute, and commit no major crimes within city borders.
        </p>
      </div>

      <div style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 24px;">
        <h2 style="font-size: 22px; color: var(--color-paper); margin-top: 0; margin-bottom: 8px;">The Metagame</h2>
        <p style="font-size: 16px; color: var(--color-paper); margin: 0;">
          Explore the hidden incentives: who profited, who was shielded, and how kidnapping prominent citizens broke the municipal truce and triggered federal intervention.
        </p>
      </div>

      <div style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 24px;">
        <h2 style="font-size: 22px; color: #4EBA74; margin-top: 0; margin-bottom: 8px;">Sourced Evidence</h2>
        <p style="font-size: 16px; color: var(--color-paper); margin: 0;">
          Grounded in 30 historical claims, federal court transcripts, and 16 documented sources. Reconstruction and folklore are strictly distinguished from verified fact.
        </p>
      </div>
    </div>

  </div>

  <script>
    import { getProgress } from '../scripts/storage';

    const progress = getProgress();
    const resumeBtn = document.getElementById('btn-resume-tour') as HTMLAnchorElement;

    if (progress.bookmark && progress.bookmark.stopId) {
      resumeBtn.style.display = 'inline-flex';
      const targetHash = progress.bookmark.blockId ? `#block-${progress.bookmark.blockId}` : '';
      if (progress.bookmark.stopId === 'prologue') {
        resumeBtn.href = `/prologue/${targetHash}`;
      } else if (progress.bookmark.stopId === 'epilogue') {
        resumeBtn.href = `/epilogue/${targetHash}`;
      } else {
        resumeBtn.href = `/stops/${progress.bookmark.stopId}/${targetHash}`;
      }
    }
  </script>
</Layout>
