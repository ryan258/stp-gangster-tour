---
import Layout from '../layouts/Layout.astro';
import {edition, stops, routeURL} from '../lib/catalog';
import ClaimLinks from '../components/ClaimLinks.astro';
import Glyph from '../components/Glyph.astro';
import ArtImage from '../components/ArtImage.astro';
import TitleSequence from '../components/TitleSequence.astro';

const chapterNumber = (order: number) => String(order).padStart(2, '0');
const sequenceEntries = stops.map((stop, index) => {
  const next = stops[index + 1];
  const onward = next
    ? {href: `#scene-${next.id}`, label: 'Next chapter'}
    : {href: '#story-coda', label: 'Go to the epilogue'};
  return {stop, onward};
});
---
<Layout title={edition.title}>
  <article class="experience-page story-home" data-story-root>
    <header class="title-cover">
      <div class="story-cover-art"><ArtImage name="hero-skyline" eager/></div>
      <div class="story-width title-cover-content">
        <p class="eyebrow story-cover-dateline">
          <span>Saint Paul, Minnesota</span> <span aria-hidden="true">/</span> <span>1900–1938</span>
        </p>
        <h1><span>Saint Paul</span>{' '}<em>After Dark</em></h1>
        <p class="story-cover-descriptor">{edition.subtitle}</p>
        <p class="story-cover-line">{edition.tagline}</p>
        <div class="story-cover-actions">
          <a class="story-enter" href="#story-opening">Enter the story <Glyph name="read"/></a>
          <details class="story-directory" id="reading-order">
            <summary>Choose a chapter</summary>
            <ol>
              {stops.map(stop => (
                <li><a href={`#scene-${stop.id}`}>{stop.title}<span aria-hidden="true">↓</span></a></li>
              ))}
            </ol>
          </details>
        </div>
        <a class="story-resume" data-resume hidden href={routeURL('/map/')}>Resume reading</a>
        <p class="story-art-credit">Atmospheric artwork · Not an archival image</p>
      </div>
    </header>

    <div class="story-journey" data-story-journey>
      <div class="story-width story-screening">
        <div class="story-screening-links">
          <a class="story-quiet-link" href={routeURL('/prologue/')}>Read the prologue <span aria-hidden="true">↗</span></a>
          <details class="story-content-note">
            <summary>Content note</summary>
            <p>{edition.contentNote}</p>
          </details>
        </div>
      </div>
      <nav class="story-rail" aria-label="Story chapters">
        <div class="story-width story-rail-inner">
          <span class="story-rail-label" aria-hidden="true" data-story-current>The seven chapters</span>
          <ol>
            {stops.map(stop => (
              <li>
                <a href={`#scene-${stop.id}`} data-story-link={stop.id} data-story-title={stop.title}>
                  <span aria-hidden="true">{chapterNumber(stop.order)}</span>
                  <span class="sr-only">Chapter {chapterNumber(stop.order)}: {stop.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <a class="story-rail-map" href={routeURL('/map/')}>View map <Glyph name="map"/></a>
        </div>
        <div class="story-progress" aria-hidden="true"><span data-story-progress></span></div>
      </nav>
      <div id="story-opening" tabindex="-1">
        {sequenceEntries.map(({stop, onward}) => <TitleSequence stop={stop} onward={onward}/>)}
      </div>
    </div>

    <section class="story-coda" id="story-coda" aria-labelledby="coda-title">
      <div class="story-coda-art"><ArtImage name="story-plate-on-the-record"/></div>
      <div class="story-width story-coda-copy">
        <p class="eyebrow">Epilogue</p>
        <h2 id="coda-title">{edition.epilogue.title}</h2>
        <p>Who absorbed the consequences?</p>
        <a class="story-enter" href={routeURL('/epilogue/')}>Read the epilogue <Glyph name="next"/></a>
        <p class="story-art-credit">AI-generated illustration</p>
      </div>
    </section>
    <section class="story-width story-afterword" aria-labelledby="afterword-title">
      <div>
        <h2 id="afterword-title">Explore the archive</h2>
        <details class="story-sources">
          <summary>Sources behind the ending</summary>
          <ClaimLinks ids={edition.epilogue.premiseClaimIds}/>
        </details>
        <a class="story-quiet-link" href="#story-opening">Return to the opening <span aria-hidden="true">↑</span></a>
      </div>
      <nav aria-label="Explore the documentation">
        <a href={routeURL('/casebook/')}><span>The casebook<small>People, connections, and evidence</small></span><Glyph name="casebook"/></a>
        <a href={routeURL('/map/')}><span>The map<small>Places in the story</small></span><Glyph name="map"/></a>
        <a href={routeURL('/sources/')}><span>The sources<small>Records, qualifications, and edition notes</small></span><Glyph name="sources"/></a>
      </nav>
    </section>
  </article>
</Layout>

<style>
  .story-cover-descriptor {
    max-width: 55ch;
    margin-block: 0 .55rem;
    color: inherit;
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }
</style>
