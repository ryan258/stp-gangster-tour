---
import Layout from '../layouts/Layout.astro';
import SvgMap from '../components/SvgMap.astro';
import {routeURL} from '../lib/catalog';
import ArtImage from '../components/ArtImage.astro';
import '../styles/map.scss';
---
<Layout title="Map and places">
  <div class="map-page">
    <header class="map-hero">
      <ArtImage class="map-hero-image" name="hero-skyline" width={1600} height={900} eager/>
      <div class="container map-hero-content">
        <div class="map-intro">
          <p class="eyebrow">Places and uncertainty</p>
          <h1>Map and places</h1>
          <p class="lede">A city of refuge. A record of consequences.</p>
          <p class="map-intro-copy">Explore the places behind seven chapters of Saint Paul’s history. Three approximate venue positions sit beside a sourced modern river; four chapters remain unplaced.</p>
          <div class="map-hero-links">
            <a href="#directory">Explore the seven stops <span aria-hidden="true">↓</span></a>
            <a data-resume hidden href={routeURL('/map/')}>Resume reading <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="map-hero-note" aria-hidden="true"><span>Same city.<br/>Different shadows.</span><small>Saint Paul, Minnesota<br/>1930s inspired artwork</small></div>
      </div>
    </header>
    <div class="container map-content"><SvgMap/></div>
  </div>
</Layout>
