---
import Layout from '../layouts/Layout.astro';import SvgMap from '../components/SvgMap.astro';import {routeURL} from '../lib/catalog';
---
<Layout title="Map and places"><div class="container"><header class="page-heading"><p class="eyebrow">Places and uncertainty</p><h1>Map and places</h1><p class="lede">A reading directory, with location precision kept separate from condition and access.</p><p>Three approximate venue positions are plotted beside a sourced modern river layer. Historical event footprints remain qualified. This page is not a walking route or an invitation to enter private property.</p><p><a data-resume hidden href={routeURL('/map/')}>Resume reading</a></p></header><SvgMap/></div></Layout>
