---
import Layout from '../layouts/Layout.astro';
import ExperienceHero from '../components/ExperienceHero.astro';
import ReadingTrail from '../components/ReadingTrail.astro';
import ClaimLinks from '../components/ClaimLinks.astro';
import {stops,evidence,people,relationships,stopURL,routeURL} from '../lib/catalog';
---
<Layout title="Casebook">
 <div class="experience-page casebook-page">
  <ExperienceHero title="The casebook" eyebrow="People. Connections. Evidence." lede="Every name has a context. Every connection has a limit." image="/images/redesign/card-on-the-record.webp" folio="FILE" note="Keep the record close.">
   <p class="hero-explainer">Everything is open from the start. Gather the people, revisit the evidence, and pick up the thread where you left it.</p><div class="experience-actions"><a data-context-return hidden href={routeURL('/map/')}>Back to the tour</a><a data-resume hidden href={routeURL('/map/')}>Resume reading</a></div>
  </ExperienceHero>
  <div class="container">
   <nav class="archive-tabs" aria-label="Casebook sections"><a href="#evidence-ledger"><span>{String(evidence.length).padStart(2,'0')}</span> Evidence</a><a href="#people"><span>{String(people.length).padStart(2,'0')}</span> People</a><a href="#relationships"><span>{String(relationships.length).padStart(2,'0')}</span> Connections</a><a href="#reading-progress"><span>07</span> Reading progress</a></nav>
   <section id="evidence-ledger"><div class="experience-section-heading"><div><p class="eyebrow">Open files / 01</p><h2>Evidence ledger</h2></div><p>{evidence.length} ways into the record.</p></div><p class="section-explainer">Source-linked explanations, with their support and limits. Inspection markers record what you have opened; they do not certify understanding or agreement.</p><div class="evidence-filter-bar"><div class="controls" data-js-control hidden><button type="button" class="btn-secondary" data-casebook-filter="all" aria-pressed="true">All evidence</button><button type="button" class="btn-secondary" data-casebook-filter="inspected" aria-pressed="false">Inspected evidence</button></div><p id="evidence-count" data-js-control hidden></p></div><p id="casebook-empty" class="archive-empty" hidden>No evidence inspected yet. Choose “All evidence” and open an item at its stop.</p>
   <div class="dossier-grid-list">{evidence.map(e=><article class="dossier-card" data-casebook-evidence={e.id}><div class="dossier-tab"><span>{e.id}</span><span>{e.materialLabel}</span></div><h3>{e.title}</h3><p>{e.description}</p><p class="record-limit"><strong>Limit</strong> {e.limits}</p><div class="dossier-card-actions"><a href={`${stopURL(e.stopId)}#evidence-${e.id}`}>Inspect {e.id} at its stop <span aria-hidden="true">↗</span></a><span data-inspected-status data-js-control hidden>Not inspected</span></div><ClaimLinks ids={e.claimIds}/></article>)}</div>
   </section>
   <section id="people"><div class="experience-section-heading"><div><p class="eyebrow">Names in the record / 02</p><h2>The people</h2></div><p>Lives beyond the legend.</p></div><div class="people-grid">{people.map((p,i)=><article class="person-dossier" id={`person-${p.id}`}><header><span class="person-file-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><p class="eyebrow">{p.period}</p><h3>{p.name}</h3></div></header><p class="person-role">{p.role}</p>{p.aliases.length>0&&<p class="muted">Also known as: {p.aliases.join(', ')}</p>}<p>{p.description}</p><p class="record-limit"><strong>Qualification</strong> {p.qualifications}</p><ClaimLinks ids={p.supportingClaimIds}/><ul class="dossier-chapters">{p.relatedStopIds.map(id=><li><a href={stopURL(id)}>{stops.find(s=>s.id===id)!.title} <span aria-hidden="true">↗</span></a></li>)}</ul></article>)}</div></section>
   <section id="relationships"><div class="experience-section-heading"><div><p class="eyebrow">Between the names / 03</p><h2>Connections and their limits</h2></div></div><div class="connection-list">{relationships.map(r=><article class="connection-card"><p class="eyebrow">{r.period} · {r.type}</p><h3><a href={`#person-${r.fromId}`}>{people.find(p=>p.id===r.fromId)!.name}</a><span aria-hidden="true">↔</span><a href={`#person-${r.toId}`}>{people.find(p=>p.id===r.toId)!.name}</a></h3><p>{r.assertion}</p><p class="record-limit"><strong>Qualification</strong> {r.qualifications}</p><ClaimLinks ids={r.premiseClaims}/></article>)}</div></section>
   <section id="reading-progress" class="trail-section"><div class="experience-section-heading"><div><p class="eyebrow">Your place in the story / 04</p><h2>Reading progress</h2></div><p id="ending-status" data-js-control hidden></p></div><ReadingTrail/><div class="progress-reset" data-js-control hidden><p>Your trail stays in this browser when saving is available.</p><button type="button" id="btn-reset-progress" class="btn-secondary">Start over</button><div id="reset-confirmation" class="card" hidden><p>Reset this browser’s reading bookmark, visited stops, and inspected evidence? Sound and Calm view preferences will be kept.</p><div class="controls"><button type="button" id="btn-cancel-reset" class="btn-secondary">Keep progress</button><button type="button" id="btn-confirm-reset">Reset reading progress</button></div></div></div></section>
  </div>
 </div>
</Layout>
