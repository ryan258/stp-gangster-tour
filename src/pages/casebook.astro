---
import Layout from '../layouts/Layout.astro';import ClaimLinks from '../components/ClaimLinks.astro';import {stops,evidence,people,relationships,stopURL} from '../lib/catalog';
---
<Layout title="Casebook"><div class="container"><header class="page-heading"><p class="eyebrow">Always open</p><h1>Casebook</h1><p class="lede">People, connections, and fourteen source-linked evidence explanations.</p><p>Everything is available from the start. Inspection markers help you find passages you have opened; they do not certify that you understand or agree with them.</p><p><a data-context-return hidden href="/map/">Back to the tour</a></p><p><a data-resume hidden href="/map/">Resume reading</a></p><nav class="controls" aria-label="Casebook sections"><a href="#evidence-ledger">Evidence</a><a href="#people">People</a><a href="#relationships">Connections</a><a href="#reading-progress">Reading progress</a></nav></header>
 <section id="evidence-ledger"><h2>Evidence ledger</h2><div class="controls" data-js-control hidden><button type="button" class="btn-secondary" data-casebook-filter="all" aria-pressed="true">All evidence</button><button type="button" class="btn-secondary" data-casebook-filter="inspected" aria-pressed="false">Inspected evidence</button></div><p id="evidence-count" data-js-control hidden></p><p id="casebook-empty" hidden>No evidence inspected yet. Choose “All evidence” and open an item at its stop.</p><div class="chapter-grid">{evidence.map(e=><article class="card casebook-item-card" data-casebook-evidence={e.id}><p class="eyebrow">{e.id} · {e.materialLabel}</p><h3>{e.title}</h3><p>{e.description}</p><p class="muted">{e.limits}</p><p data-inspected-status data-js-control hidden>Not inspected</p><a href={`${stopURL(e.stopId)}#evidence-${e.id}`}>Inspect {e.id} at its stop</a><ClaimLinks ids={e.claimIds}/></article>)}</div></section>
 <section id="people"><h2>People</h2><div class="chapter-grid">{people.map(p=><article class="card" id={`person-${p.id}`}><p class="eyebrow">{p.period}</p><h3>{p.name}</h3><p>{p.role}</p>{p.aliases.length>0&&<p class="muted">Also known as: {p.aliases.join(', ')}</p>}<p>{p.description}</p><p class="muted">{p.qualifications}</p><ClaimLinks ids={p.supportingClaimIds}/><ul>{p.relatedStopIds.map(id=><li><a href={stopURL(id)}>{stops.find(s=>s.id===id)!.title}</a></li>)}</ul></article>)}</div></section>
 <section id="relationships" class="prose"><h2>Connections and their limits</h2>{relationships.map(r=><article class="card"><p class="eyebrow">{r.period} · {r.type}</p><h3><a href={`#person-${r.fromId}`}>{people.find(p=>p.id===r.fromId)!.name}</a> / <a href={`#person-${r.toId}`}>{people.find(p=>p.id===r.toId)!.name}</a></h3><p>{r.assertion}</p><p class="muted">{r.qualifications}</p><ClaimLinks ids={r.premiseClaims}/></article>)}</section>
 <section id="reading-progress" class="prose"><h2>Reading progress</h2><ul>{stops.map(s=><li><a href={stopURL(s.id)}>{s.title}</a> <span data-visited-stop={s.id} data-js-control hidden></span></li>)}</ul><p id="ending-status" data-js-control hidden></p><div data-js-control hidden><button type="button" id="btn-reset-progress" class="btn-secondary">Start over</button><div id="reset-confirmation" class="card" hidden><p>Reset this browser’s reading bookmark, visited stops, and inspected evidence? Sound and Calm view preferences will be kept.</p><div class="controls"><button type="button" id="btn-cancel-reset" class="btn-secondary">Keep progress</button><button type="button" id="btn-confirm-reset">Reset reading progress</button></div></div></div></section>
</div></Layout>
