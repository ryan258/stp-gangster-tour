---
import Layout from '../layouts/Layout.astro';
import evidenceData from '../data/evidence.json';
import stopsData from '../data/stops.json';

const stopMap = new Map(stopsData.map(s => [s.id, s]));
---

<Layout title="Casebook: Evidence & Investigation" currentPath="/casebook/">
  <div style="max-width: var(--container-prose-width); margin: 0 auto; padding: 20px 0 60px;">
    
    <div style="margin-bottom: 24px;">
      <span class="badge badge-exact" style="margin-bottom: 8px;">INVESTIGATION DOSSIER</span>
      <h1 style="margin-top: 4px; margin-bottom: 12px;">Casebook Evidence Ledger</h1>
      <p style="font-size: 20px; color: var(--color-muted); line-height: 1.5; font-style: italic;">
        Review all fourteen historical evidence records across the seven stops. Inspected records are remembered locally in your browser.
      </p>
    </div>

    <!-- Casebook Status & Filter Controls (Spec R5) -->
    <div style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px; margin-bottom: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <span style="font-family: var(--font-title); font-size: 20px; color: var(--color-paper); font-weight: 600;">
          Evidence Inspected: 
          <span id="casebook-inspected-count" style="color: var(--color-accent); font-weight: 700;">0</span> / {evidenceData.length}
        </span>
      </div>

      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button 
          type="button" 
          id="filter-all-evidence" 
          class="btn btn-secondary active" 
          aria-pressed="true"
        >
          All ({evidenceData.length})
        </button>
        <button 
          type="button" 
          id="filter-inspected-evidence" 
          class="btn btn-secondary" 
          aria-pressed="false"
        >
          Inspected Only
        </button>
      </div>
    </div>

    <!-- Evidence Item List -->
    <div id="casebook-list" style="display: flex; flex-direction: column; gap: 16px;">
      {evidenceData.map(ev => {
        const owningStop = stopMap.get(ev.stopId);
        return (
          <div 
            class="casebook-item-card" 
            data-evidence-id={ev.id}
            style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px; transition: border-color var(--transition-fast);"
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
              <div>
                <span style="color: var(--color-accent); font-weight: 700; margin-right: 8px;">{ev.id}</span>
                <span style="font-family: var(--font-title); font-size: 20px; font-weight: 600; color: var(--color-paper);">
                  {ev.title}
                </span>
              </div>
              <div style="display: flex; gap: 6px; align-items: center;">
                <span class="casebook-status-tag badge badge-context">Uninspected</span>
                <span class="badge badge-approx">{ev.materialLabel}</span>
              </div>
            </div>

            <p style="font-size: 16px; line-height: 1.6; color: var(--color-paper); margin-bottom: 12px;">
              {ev.description}
            </p>

            <div style="background: rgba(14, 17, 23, 0.6); padding: 10px 14px; border-radius: 4px; margin-bottom: 12px; font-size: 14px;">
              <strong style="color: #4EBA74;">What this supports:</strong> {ev.supports}
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--color-muted); border-top: 1px solid var(--color-border-subtle); padding-top: 10px;">
              <div>
                {owningStop && (
                  <span>
                    Location: <a href={`/stops/${owningStop.id}/`}>Stop {owningStop.order}: {owningStop.title}</a>
                  </span>
                )}
              </div>
              <div>
                <span>Claims: {ev.claimIds.join(', ')}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Start Over / Reset Controls (Spec R5) -->
    <div style="margin-top: 48px; border-top: 1px solid var(--color-border-subtle); padding-top: 24px;">
      <button 
        type="button" 
        id="btn-start-over" 
        class="btn btn-secondary" 
        style="border-color: var(--color-accent); color: var(--color-accent);"
      >
        Start tour over...
      </button>

      <!-- Confirmation Box -->
      <div 
        id="start-over-confirmation" 
        style="display: none; background: rgba(198, 47, 66, 0.1); border: 1px solid var(--color-accent); border-radius: 6px; padding: 20px; margin-top: 16px;"
      >
        <p style="font-size: 16px; color: var(--color-paper); margin-top: 0; margin-bottom: 16px;">
          <strong>Reset tour progress?</strong> This clears visited stops and inspected evidence bookmarks, but preserves your sound and Calm view preferences.
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <button type="button" id="btn-keep-progress" class="btn btn-secondary">
            Keep progress
          </button>
          <button type="button" id="btn-confirm-clear" class="btn btn-primary" style="background: var(--color-accent);">
            Yes, reset progress
          </button>
        </div>
      </div>
    </div>

  </div>

  <script>
    import { initCasebookPage } from '../scripts/casebook';
    initCasebookPage();
  </script>
</Layout>
