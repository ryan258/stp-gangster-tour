---
import Layout from '../layouts/Layout.astro';
import ExperienceHero from '../components/ExperienceHero.astro';
import {routeURL} from '../lib/catalog';
---
<Layout title="Page not found"><div class="experience-page missing-page"><ExperienceHero title="This page is not in the casebook" eyebrow="A loose end" lede="The link may be incomplete or out of date. Your saved progress has not been reset." image="/images/redesign/card-the-arrangement.webp" folio="404" note="Pick up another thread."><div class="experience-actions"><a data-resume hidden href={routeURL('/map/')}>Resume reading</a><a href={routeURL('/map/')}>Find a stop <span aria-hidden="true">→</span></a><a href={routeURL('/')}>Go home <span aria-hidden="true">↗</span></a></div></ExperienceHero></div></Layout>
