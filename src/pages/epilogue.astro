---
import Layout from '../layouts/Layout.astro';import ClaimLinks from '../components/ClaimLinks.astro';import {edition,stops,stopURL} from '../lib/catalog';
---
<Layout title="Epilogue"><article class="container prose reading-page" data-reading-page="epilogue"><section id="opening" data-reading-block><p class="eyebrow">Epilogue · Tour explanation</p><h1>{edition.epilogue.title}</h1>{edition.epilogue.paragraphs.map(p=><p>{p}</p>)}<ClaimLinks ids={edition.epilogue.premiseClaimIds}/></section><section><h2>Your reading trail</h2><p id="ending-status" data-js-control hidden></p><ul>{stops.map(s=><li><a href={stopURL(s.id)}>{s.title}</a> <span class="muted" data-visited-stop={s.id} data-js-control hidden></span></li>)}</ul><p><a href="/casebook/">Revisit people and inspected evidence</a></p></section><nav class="stop-nav" aria-label="Reading order"><a href={stopURL(stops[6].id)}>← Previous: {stops[6].title}</a><a href="/map/">Return to the map →</a></nav></article></Layout>
