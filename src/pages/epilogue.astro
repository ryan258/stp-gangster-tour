---
import Layout from '../layouts/Layout.astro';
import EditorialChapterHero from '../components/EditorialChapterHero.astro';
import ReadingTrail from '../components/ReadingTrail.astro';
import ClaimLinks from '../components/ClaimLinks.astro';
import {edition, stops, stopURL, routeURL} from '../lib/catalog';
import '../styles/editorial-chapters.scss';

const last = stops[stops.length - 1];
---

<Layout title="Epilogue" description={edition.epilogue.summary}>
  <article class="experience-page bookend-page epilogue-page tour-editorial" data-reading-page="epilogue">
    <EditorialChapterHero
      title={edition.epilogue.title}
      label="Epilogue · Tour interpretation"
      image="banner-bridge"
    >
      <nav class="experience-actions editorial-hero-actions" aria-label="Epilogue sections">
        <a href="#opening">Read the epilogue <span aria-hidden="true">↓</span></a>
        <a href="#reading-trail">Your reading trail <span aria-hidden="true">↓</span></a>
      </nav>
    </EditorialChapterHero>

    <div class="container epilogue-reading">
      <div class="bookend-prose">
        <section id="opening" data-reading-block class="story-opening">
          <h2>After the bargain</h2>
          {edition.epilogue.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          <details class="story-sources">
            <summary>Sources behind the epilogue</summary>
            <ClaimLinks ids={edition.epilogue.premiseClaimIds}/>
          </details>
        </section>
      </div>
    </div>

    <section class="epilogue-reflection" aria-labelledby="reflection-heading">
      <div class="container">
        <p class="eyebrow">Return to the city</p>
        <h2 id="reflection-heading">Who could shape another person’s choices?</h2>
        <p>Who absorbed the consequences?</p>
        <div class="experience-actions">
          <a href={routeURL('/map/')}>Return to the map <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="container trail-section" id="reading-trail" aria-labelledby="trail-heading">
      <div class="experience-section-heading">
        <h2 id="trail-heading">Your reading trail</h2>
        <p id="ending-status" data-js-control hidden></p>
      </div>
      <ReadingTrail/>
      <div class="experience-actions">
        <a href={routeURL('/casebook/')}>Revisit people and inspected evidence <span aria-hidden="true">→</span></a>
        <a href={routeURL('/sources/')}>Follow the source trail <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="stop-nav" aria-label="Reading order">
        <a href={stopURL(last.id)}>← Previous: {last.title}</a>
      </nav>
    </section>
  </article>
</Layout>
