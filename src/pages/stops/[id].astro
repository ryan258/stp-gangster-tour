---
import Layout from '../../layouts/Layout.astro';
import TitleSequence from '../../components/TitleSequence.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import EvidenceItem from '../../components/EvidenceItem.astro';
import Presenter from '../../components/Presenter.astro';
import StopNav from '../../components/StopNav.astro';
import ClaimLinks from '../../components/ClaimLinks.astro';
import {edition,stops,evidence,media,locations,people,metagames,presenters,stopURL,routeURL,assetURL} from '../../lib/catalog';
import ArtImage from '../../components/ArtImage.astro';
import PopUpScene from '../../components/PopUpScene.astro';
import ActorBoard from '../../components/ActorBoard.astro';
import MarkedText from '../../components/MarkedText.astro';
import {hasPopUp} from '../../lib/popup';
import {boardFor} from '../../lib/board';
import {listeningPending} from '../../lib/release';
import {featuredTitleScenes} from '../../lib/title-sequence';
import visualStory from '../../data/visual-story.json';
import '../../styles/board.scss';
import '../../styles/editorial-chapters.scss';
export function getStaticPaths(){return stops.map((stop,index)=>({params:{id:stop.id},props:{stop,index}}));}
const {stop,index}=Astro.props;
const scene=media.scenes.find(s=>s.id===stop.sceneId)!;
const narration=media.narration.find(n=>n.id===stop.narrationId)!;
const ambience=media.ambience.find(a=>a.id===stop.ambienceId)!;
const featured = featuredTitleScenes[stop.id];
const narrationProps = {
  audioSrc: assetURL(narration.file),
  ambienceSrc: assetURL(ambience.file),
  voice: narration.voice,
  listeningPending: listeningPending(narration.id),
};
const loc=locations.find(l=>l.id===stop.locationId)!;
const metagame=metagames.find(m=>m.id===stop.blocks.metagame.metagameId)!;
const presenter=presenters.find(p=>p.stopId===stop.id)!;
const next=stops[index+1];
const storyBeat = visualStory[stop.id as keyof typeof visualStory];
const sceneClaimIds = [...new Set([...stop.blocks.intro.claimIds, ...storyBeat.claimIds])];
// Chapters with a board scroll their text beside it instead of using the pop-up scene.
const board=boardFor(stop.id);
const marks=(block:'intro'|'record'|'metagame')=>board?.markers.filter(m=>m.block===block)??[];
---

<Layout title={stop.title} description={stop.synopsis} stopNumber={index+1}>
  <article class="experience-page chapter-page tour-editorial" data-reading-page={stop.id}>
    <TitleSequence stop={stop}>
      <Fragment slot="narration">{featured && <AudioPlayer {...narrationProps}/>}</Fragment>
    </TitleSequence>

    {hasPopUp(scene.id) && !board && <div class="container"><PopUpScene scene={scene}/></div>}
    <div class="container">
      <div class="chapter-navigation">
        <StopNav index={index} position="top"/>
        <nav class="archive-tabs chapter-tabs" aria-label="On this page">
          <a href="#intro">Introduction</a>
          <a href="#record">The record</a>
          <a href="#metagame">The underlying bargain</a>
          <a href="#evidence">Evidence</a>
        </nav>
      </div>

      <div class:list={['chapter-layout', {'has-board': !!board}]}>
        <div class="chapter-prose">
          <section id="intro" data-reading-block class="story-opening">
            <h2>{stop.chapterNote}</h2>
            <p><MarkedText text={stop.blocks.intro.text} markers={marks('intro')}/></p>
            <details class="story-sources">
              <summary>Sources behind this scene</summary>
              <ClaimLinks ids={sceneClaimIds} from={stop.id}/>
            </details>
            {featured
              ? <a class="btn btn-secondary" href="#chapter-narration">Listen to this introduction</a>
              : <AudioPlayer {...narrationProps}/>}
          </section>
          <section id="record" data-reading-block>
            <h2>The record</h2>
            <p><MarkedText text={stop.blocks.record.text} markers={marks('record')}/></p>
            <details class="story-sources">
              <summary>Trace the record</summary>
              <ClaimLinks ids={stop.blocks.record.claimIds} from={stop.id}/>
            </details>
            <Presenter presenter={presenter}/>
          </section>
          <section id="metagame" data-reading-block class="bargain-section">
            <p class="eyebrow">Tour interpretation</p>
            <h2>{metagame.title}</h2>
            <p><MarkedText text={stop.blocks.metagame.text} markers={marks('metagame')}/></p>
            <details class="story-sources">
              <summary>What this interpretation rests on</summary>
              <ClaimLinks ids={metagame.premiseClaims} from={stop.id}/>
            </details>
            {!board && <details class="card analysis-disclosure">
              <summary>Examine aims, responses, and costs</summary>
              <ul>{metagame.actors.map(actor => <li><strong>{actor.name}:</strong> {actor.role}{!actor.isDocumented && ' — analytical perspective'}</li>)}</ul>
              <p><strong>Aims:</strong> {metagame.aims}</p>
              <p><strong>Expected benefit:</strong> {metagame.expectedBenefit}</p>
              <p><strong>Who bore the costs:</strong> {metagame.bearingCosts}</p>
              <p><strong>Reported response:</strong> {metagame.observedResponse}</p>
              <p><strong>Limit:</strong> {metagame.evidentiaryLimit}</p>
            </details>}
          </section>
        </div>
        <div class="chapter-aside">
          {board
            ? <ActorBoard metagame={metagame} actors={board.actors} beats={board.beats}/>
            : <figure class="experience-photo chapter-photo">
              <ArtImage name={`card-${stop.id}`} sizes="(min-width: 1000px) 400px, 100vw"/>
              <figcaption>Atmospheric illustration</figcaption>
            </figure>}
        </div>
      </div>
    </div>

    <section id="evidence" class="chapter-evidence" aria-labelledby="evidence-heading">
      <div class="container chapter-evidence-inner">
        <div class="chapter-evidence-copy">
          <h2 id="evidence-heading">Inspect the evidence</h2>
          <p>Open an item to see what it supports, where the record stops, and where to find the source.</p>
          <p>Opening an item marks it inspected when saving is available.</p>
        </div>
        <div class="chapter-evidence-items">
          {stop.evidenceIds.map(id => {
            const item = evidence.find(entry => entry.id === id);
            return item && <EvidenceItem evidence={item}/>;
          })}
        </div>
      </div>
    </section>

    <div class="container">
      <section class="chapter-context" aria-label="Place and chapter notes">
        <div id="place" class="paper-document place-file">
          <h2>{loc.historicalName}</h2>
          <p>{loc.address}</p>
          <dl class="place-status">
            <div><dt>Position</dt><dd>{loc.precision}</dd></div>
            <div><dt>Condition</dt><dd>{loc.condition}</dd></div>
            <div><dt>Access</dt><dd>{loc.access}</dd></div>
          </dl>
          <p>{loc.qualification}</p>
          <a href={routeURL(`/map/#location-${loc.id}`)}>Location notes on the map <span aria-hidden="true">↗</span></a>
        </div>
        <section class="chapter-connections" aria-labelledby="connections-heading">
          <h2 id="connections-heading">People and connections</h2>
          <ul>{stop.relatedPersonIds.map(id => {
            const person = people.find(entry => entry.id === id);
            return <li><a href={routeURL(`/casebook/?from=${stop.id}#person-${id}`)}>{person?.name}</a><span>{person?.role}</span></li>;
          })}</ul>
          <h3>Connected chapters</h3>
          <ul>{stop.relatedStopIds.map(id => <li><a href={stopURL(id)}>{stops.find(entry => entry.id === id)?.title} <span aria-hidden="true">↗</span></a></li>)}</ul>
          <a class="chapter-casebook" href={routeURL(`/casebook/?from=${stop.id}`)}>Open the casebook <span aria-hidden="true">↗</span></a>
        </section>
        {(!hasPopUp(scene.id) || board) && <details class="scene-study">
          <summary>Illustrated scene study</summary>
          <figure>
            <img src={assetURL(scene.file)} width={scene.width} height={scene.height} alt={scene.description} decoding="async" loading="lazy"/>
            <figcaption>Reconstruction · Generalized illustration. Architecture, sightlines, and depicted figures are not verified.</figcaption>
          </figure>
        </details>}
      </section>
      <a class="next-chapter-teaser" href={next ? stopURL(next.id) : routeURL('/epilogue/')}>
        <ArtImage name={next ? `card-${next.id}` : 'hero-skyline'} sizes="(min-width: 1200px) 650px, (min-width: 541px) 54vw, 100vw"/>
        <span>
          <small>{next ? `Next · Chapter ${String(next.order).padStart(2,'0')} · ${next.period}` : 'Next · Epilogue'}</small>
          <strong>{next ? next.title : edition.epilogue.title}</strong>
          {next && <em>{next.chapterNote}</em>}
        </span>
        <b aria-hidden="true">→</b>
        <span class="editorial-teaser-art-credit">Atmospheric illustration</span>
      </a>
      <StopNav index={index} position="bottom"/>
      <details class="chapter-index">
        <summary>Browse all seven chapters</summary>
        <ol>{stops.map(item => <li>
          <a href={stopURL(item.id)} aria-current={item.id === stop.id ? 'page' : undefined}>
            <span aria-hidden="true">{String(item.order).padStart(2,'0')}</span>{item.title}
          </a>
        </li>)}</ol>
      </details>
    </div>
  </article>
</Layout>
