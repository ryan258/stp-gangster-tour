---
import Layout from '../../layouts/Layout.astro';
import ExperienceHero from '../../components/ExperienceHero.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import EvidenceItem from '../../components/EvidenceItem.astro';
import Presenter from '../../components/Presenter.astro';
import StopNav from '../../components/StopNav.astro';
import ClaimLinks from '../../components/ClaimLinks.astro';
import {stops,evidence,media,locations,people,metagames,presenters,stopURL,routeURL,assetURL} from '../../lib/catalog';
import ArtImage from '../../components/ArtImage.astro';
import PopUpScene from '../../components/PopUpScene.astro';
import {hasPopUp} from '../../lib/popup';
export function getStaticPaths(){return stops.map((stop,index)=>({params:{id:stop.id},props:{stop,index}}));}
const {stop,index}=Astro.props;
const scene=media.scenes.find(s=>s.id===stop.sceneId)!;
const narration=media.narration.find(n=>n.id===stop.narrationId)!;
const ambience=media.ambience.find(a=>a.id===stop.ambienceId)!;
const loc=locations.find(l=>l.id===stop.locationId)!;
const metagame=metagames.find(m=>m.id===stop.blocks.metagame.metagameId)!;
const presenter=presenters.find(p=>p.stopId===stop.id)!;
const next=stops[index+1];
---

<Layout title={stop.title} description={stop.synopsis} stopNumber={index+1}>
 <article class="experience-page chapter-page" data-reading-page={stop.id}>
  <ExperienceHero title={stop.title} eyebrow={`Chapter ${String(index+1).padStart(2,'0')} · ${stop.period}`} lede={stop.synopsis} image={`/images/redesign/card-${stop.id}.webp`} folio={String(index+1).padStart(2,'0')} note={loc.historicalName}>
   <nav class="experience-actions" aria-label="Chapter entry"><a href="#intro">Read the chapter <span aria-hidden="true">↓</span></a><a href="#evidence">Inspect the evidence <span aria-hidden="true">↗</span></a></nav>
  </ExperienceHero>
  {hasPopUp(scene.id)&&<div class="container"><PopUpScene scene={scene}/></div>}
  <div class="container">
   <div class="chapter-navigation"><StopNav index={index} position="top"/><nav class="archive-tabs chapter-tabs" aria-label="On this page"><a href="#intro"><span aria-hidden="true">01</span> Introduction</a><a href="#record"><span aria-hidden="true">02</span> The record</a><a href="#metagame"><span aria-hidden="true">03</span> The underlying bargain</a><a href="#evidence"><span aria-hidden="true">04</span> Evidence</a></nav></div>
   <div class="chapter-layout">
    <div class="chapter-prose">
     <section id="intro" data-reading-block class="story-opening"><p class="eyebrow">Enter the story</p><h2>{stop.chapterNote}</h2><p>{stop.blocks.intro.text}</p><details class="story-sources"><summary>Sources behind this scene</summary><ClaimLinks ids={stop.blocks.intro.claimIds} from={stop.id}/></details><AudioPlayer audioSrc={assetURL(narration.file)} ambienceSrc={assetURL(ambience.file)}/></section>
     <section id="record" data-reading-block><p class="eyebrow">Follow the paper trail</p><h2>The record</h2><p>{stop.blocks.record.text}</p><details class="story-sources"><summary>Trace the record</summary><ClaimLinks ids={stop.blocks.record.claimIds} from={stop.id}/></details><Presenter presenter={presenter}/></section>
     <section id="metagame" data-reading-block class="bargain-section"><p class="eyebrow">Tour explanation · Interpretation</p><h2>{metagame.title}</h2><p>{stop.blocks.metagame.text}</p><details class="story-sources"><summary>What this interpretation rests on</summary><ClaimLinks ids={metagame.premiseClaims} from={stop.id}/></details>
      <details class="card analysis-disclosure"><summary>Examine aims, responses, and costs</summary><ul>{metagame.actors.map(a=><li><strong>{a.name}:</strong> {a.role}{!a.isDocumented?' — analytical perspective':''}</li>)}</ul><p><strong>Aims:</strong> {metagame.aims}</p><p><strong>Expected benefit:</strong> {metagame.expectedBenefit}</p><p><strong>Who bore the costs:</strong> {metagame.bearingCosts}</p><p><strong>Reported response:</strong> {metagame.observedResponse}</p><p><strong>Limit:</strong> {metagame.evidentiaryLimit}</p></details>
     </section>
     <section id="evidence"><p class="eyebrow">Look closer</p><h2>Inspect the evidence</h2><p>These are source-linked explanations. Original records stay with the linked archives. Opening an item marks it inspected when saving is available.</p>{stop.evidenceIds.map(id=>{const ev=evidence.find(e=>e.id===id);return ev ? <EvidenceItem evidence={ev}/> : null})}</section>
     <section class="chapter-connections"><p class="eyebrow">Follow another thread</p><h2>People and connections</h2><ul>{stop.relatedPersonIds.map(id=>{const p=people.find(p=>p.id===id);return <li><a href={routeURL(`/casebook/?from=${stop.id}#person-${id}`)}>{p?.name}</a><span>{p?.role}</span></li>})}</ul><h3>Connected chapters</h3><ul>{stop.relatedStopIds.map(id=><li><a href={stopURL(id)}>{stops.find(s=>s.id===id)?.title} <span aria-hidden="true">↗</span></a></li>)}</ul></section>
    </div>
    <aside class="chapter-aside">
     <figure class="experience-photo chapter-photo"><ArtImage name={`card-${stop.id}`} sizes="(min-width: 1000px) 400px, 100vw"/><figcaption>{stop.title}<br/><small>Atmospheric artwork, not a documentary photograph.</small></figcaption></figure>
    </aside>
   </div>
   <section class="chapter-context" aria-label="Place and chapter notes">
     <div class="paper-document place-file"><p class="paper-kicker">Location file / {String(index+1).padStart(2,'0')}</p><h2>The place</h2><p class="place-name">{loc.historicalName}</p><p>{loc.address}</p><dl class="place-status"><div><dt>Position</dt><dd>{loc.precision}</dd></div><div><dt>Condition</dt><dd>{loc.condition}</dd></div><div><dt>Access</dt><dd>{loc.access}</dd></div></dl><p>{loc.qualification}</p><a href={routeURL(`/map/#location-${loc.id}`)}>Location notes <span aria-hidden="true">↗</span></a></div>
     <div class="chapter-index"><p class="eyebrow">The seven chapters</p><ol>{stops.map(s=><li><a href={stopURL(s.id)} aria-current={s.id===stop.id?'page':undefined}><span aria-hidden="true">{String(s.order).padStart(2,'0')}</span>{s.title}</a></li>)}</ol><a class="chapter-casebook" href={routeURL(`/casebook/?from=${stop.id}`)}>Open the casebook <span aria-hidden="true">↗</span></a></div>
     {!hasPopUp(scene.id)&&<details class="scene-study"><summary>Illustrated scene study</summary><figure><img src={assetURL(scene.file)} width={scene.width} height={scene.height} alt={scene.description} decoding="async"/><figcaption>Reconstruction · Generalized illustration. Architecture, sightlines, and depicted figures are not verified.</figcaption></figure></details>}
   </section>
   <a class="next-chapter-teaser" href={next?stopURL(next.id):routeURL('/epilogue/')}><ArtImage name={next?`card-${next.id}`:'banner-bridge'} sizes="(min-width: 800px) 300px, 100vw"/><span><small>{next?`Next / Chapter ${String(next.order).padStart(2,'0')}`:'Next / Epilogue'}</small><strong>{next?next.title:'What the Arrangement Could Not Control'}</strong><em>Keep following the story.</em></span><b aria-hidden="true">→</b></a>
   <StopNav index={index} position="bottom"/>
  </div>
 </article>
</Layout>
