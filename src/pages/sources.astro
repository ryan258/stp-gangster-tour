---
import Layout from '../layouts/Layout.astro';
import claimsData from '../data/claims.json';
import sourcesData from '../data/sources.json';
---

<Layout title="Sources & Claims Ledger" currentPath="/sources/">
  <div style="max-width: var(--container-prose-width); margin: 0 auto; padding: 20px 0 60px;">
    
    <div style="margin-bottom: 24px;">
      <span class="badge badge-exact" style="margin-bottom: 8px;">RESEARCH LEDGER</span>
      <h1 style="margin-top: 4px; margin-bottom: 12px;">Sources &amp; Verified Claims</h1>
      <p style="font-size: 20px; color: var(--color-muted); line-height: 1.5; font-style: italic;">
        Every assertion in this tour is tied to a specific claim and documented historical source.
      </p>
    </div>

    <!-- Quick Jump Links -->
    <div style="display: flex; gap: 12px; margin-bottom: 36px;">
      <a href="#claims-section" class="btn btn-secondary">Jump to Claims (30)</a>
      <a href="#sources-section" class="btn btn-secondary">Jump to Sources (16)</a>
    </div>

    <!-- Section 1: Claims (C01 - C30) -->
    <section id="claims-section" style="margin-bottom: 60px;">
      <h2 style="font-size: 28px; margin-bottom: 12px; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        Historical Claims (C01–C30)
      </h2>
      <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 24px;">
        Evaluated according to evidentiary basis, qualification limits, and research verification dates.
      </p>

      <div style="display: flex; flex-direction: column; gap: 16px;">
        {claimsData.map(c => (
          <div 
            id={`claim-${c.id}`} 
            style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px; scroll-margin-top: 80px;"
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
              <div>
                <span style="color: var(--color-accent); font-weight: 700; margin-right: 8px;">{c.id}</span>
                <span style="font-family: var(--font-title); font-size: 18px; font-weight: 600; color: var(--color-paper);">
                  {c.assertion}
                </span>
              </div>
              <span class={`badge ${c.status === 'Supported' ? 'badge-exact' : 'badge-approx'}`}>
                {c.status}
              </span>
            </div>

            <p style="font-size: 15px; color: var(--color-paper); margin-bottom: 8px;">
              <strong>Support Explanation:</strong> {c.supportExplanation}
            </p>

            <div style="background: rgba(14, 17, 23, 0.6); padding: 10px 14px; border-radius: 4px; margin-bottom: 12px; font-size: 14px; border-left: 3px solid var(--color-accent);">
              <strong style="color: var(--color-accent);">Qualification / Limitation:</strong> 
              <span style="color: var(--color-muted);">{c.qualification}</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--color-muted);">
              <div>
                <strong>Sources:</strong> 
                {c.sourceIds.map((sid, idx) => (
                  <span>
                    <a href={`#source-${sid}`}>{sid}</a>{idx < c.sourceIds.length - 1 ? ', ' : ''}
                  </span>
                ))} 
                <span>({c.locators})</span>
              </div>
              <div>
                <span>Verified: {c.passageCheckDate}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Sources (S01 - S16) -->
    <section id="sources-section">
      <h2 style="font-size: 28px; margin-bottom: 12px; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        Documented Sources (S01–S16)
      </h2>
      <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 24px;">
        Historical accounts, court opinions, corporate filings, FBI records, and period news publications.
      </p>

      <div style="display: flex; flex-direction: column; gap: 16px;">
        {sourcesData.map(s => (
          <div 
            id={`source-${s.id}`} 
            style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: 6px; padding: 20px; scroll-margin-top: 80px;"
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
              <div>
                <span style="color: var(--color-accent); font-weight: 700; margin-right: 8px;">{s.id}</span>
                <span style="font-family: var(--font-title); font-size: 20px; font-weight: 600; color: var(--color-paper);">
                  {s.title}
                </span>
              </div>
              <span class="badge badge-approx">{s.sourceType}</span>
            </div>

            <p style="font-size: 15px; color: var(--color-paper); margin-bottom: 6px;">
              <strong>Creator / Author:</strong> {s.creator}
            </p>

            {s.passageLocators && (
              <p style="font-size: 14px; color: var(--color-paper); margin-bottom: 6px;">
                <strong>Key Passages:</strong> {s.passageLocators}
              </p>
            )}

            <div style="background: rgba(14, 17, 23, 0.6); padding: 10px 14px; border-radius: 4px; margin-bottom: 12px; font-size: 14px; border-left: 3px solid var(--color-accent);">
              <strong style="color: var(--color-accent);">Evidentiary Limits:</strong> 
              <span style="color: var(--color-muted);">{s.limits}</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--color-muted);">
              <div>
                {s.url && (
                  <a href={s.url} target="_blank" rel="noopener noreferrer" style="color: var(--color-accent);">
                    View External Archive &rarr;
                  </a>
                )}
              </div>
              <div>
                <span>Consulted: {s.consultationDate}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
