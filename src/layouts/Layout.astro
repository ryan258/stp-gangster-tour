---
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-900.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/cinzel/latin-500.css';
import '@fontsource/cinzel/latin-700.css';
import '@fontsource/cinzel/latin-900.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/caveat/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/main.scss';
import '../styles/experience.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import {edition,assetURL} from '../lib/catalog';
interface Props {title:string;description?:string;currentPath?:string;stopNumber?:number;totalStops?:number;}
const {title,description=edition.subtitle,currentPath=Astro.url.pathname,stopNumber,totalStops=7}=Astro.props;
const site=Astro.site??new URL('https://ryan258.github.io');
const canonical=new URL(Astro.url.pathname,site).href;
const ogImage=new URL(assetURL('/images/redesign/hero-skyline.webp'),site).href;
const fullTitle=title===edition.title?edition.title:`${title} | ${edition.title}`;
const preview=edition.releaseStatus!=='reviewed';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="description" content={description}/>
  <meta name="color-scheme" content="dark"/>
  <meta name="theme-color" content="#090b0e"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="apple-mobile-web-app-title" content="After Dark"/>
  <meta name="application-name" content="After Dark"/>
  <meta name="referrer" content="strict-origin-when-cross-origin"/>
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href={assetURL('/favicon.svg')}/>
  <link rel="apple-touch-icon" sizes="180x180" href={assetURL('/apple-touch-icon.png')}/>
  <link rel="apple-touch-icon" href={assetURL('/apple-touch-icon.png')}/>
  <link rel="manifest" href={assetURL('/site.webmanifest')}/>
  {preview&&<meta name="robots" content="noindex"/>}
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content={edition.title}/>
  <meta property="og:title" content={fullTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="preload" href={assetURL('/fonts/source-sans-3-regular.woff2')} as="font" type="font/woff2" crossorigin/>
</head>
<body>
  <SkipLink/>
  <Header currentPath={currentPath} stopNumber={stopNumber} totalStops={totalStops}/>
  <p id="storage-notice" class="storage-notice" role="status" hidden></p>
  <main id="main-content" tabindex="-1"><slot/></main>
  <Footer/>
  <noscript><p class="container">Reading, navigation, sources, and evidence disclosures work without JavaScript. Saved progress, emphasis controls, and audio are unavailable.</p></noscript>
  <script>
    import {initCalmView} from '../scripts/calm';
    import {initSelectionPresenters} from '../scripts/selection';
    import {initEvidenceDisclosures} from '../scripts/casebook';
    import {initReading} from '../scripts/reading';
    for(const initialize of [initCalmView,initSelectionPresenters,initEvidenceDisclosures,initReading]){
      try{initialize();}catch(error){console.error('An optional tour enhancement could not initialize.',error);}
    }
  </script>
</body>
</html>
