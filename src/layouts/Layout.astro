---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import {edition} from '../lib/catalog';
interface Props {title:string;description?:string;currentPath?:string;stopNumber?:number;totalStops?:number;}
const {title,description=edition.subtitle,currentPath=Astro.url.pathname,stopNumber,totalStops=7}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="dark"/><meta name="referrer" content="strict-origin-when-cross-origin"/><title>{title} | {edition.title}</title><link rel="preload" href="/fonts/source-sans-3-regular.woff2" as="font" type="font/woff2" crossorigin/></head>
<body><SkipLink/><Header currentPath={currentPath} stopNumber={stopNumber} totalStops={totalStops}/>
 {edition.releaseStatus==='preview'&&<aside class="preview-note" aria-label="Edition status">Work in progress · Source qualifications are part of the story. Audio, illustration, and location review remains open. <a href="/sources/#edition-status">Edition notes</a></aside>}
 <p id="storage-notice" class="storage-notice" role="status" hidden></p>
 <main id="main-content" tabindex="-1"><slot/></main><Footer/>
 <noscript><p class="container">Reading, navigation, sources, and evidence disclosures work without JavaScript. Saved progress, emphasis controls, and audio are unavailable.</p></noscript>
 <script>
 import {initCalmView} from '../scripts/calm';import {initSelectionPresenters} from '../scripts/selection';import {initEvidenceDisclosures} from '../scripts/casebook';import {initReading} from '../scripts/reading';
 for(const initialize of [initCalmView,initSelectionPresenters,initEvidenceDisclosures,initReading]){try{initialize();}catch(error){console.error('An optional tour enhancement could not initialize.',error);}}
 </script>
</body></html>
