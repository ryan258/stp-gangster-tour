{
  "name": "stp-gangster-tour",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/validate-content.mjs && astro dev --host 127.0.0.1 --ignore-lock",
    "check": "astro check && node ./scripts/validate-content.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "preview": "astro preview --outDir dist-preview --host 127.0.0.1 --ignore-lock",
    "build:preview": "node scripts/build.mjs --preview",
    "validate": "node ./scripts/validate-content.mjs",
    "preview:production": "astro preview --outDir dist --host 127.0.0.1 --ignore-lock"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "7.3.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "sass": "^1.105.1",
    "typescript": "^5.7.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  }
}
